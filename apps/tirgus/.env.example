# Copy to .env.local and fill in values

# Supabase (nosaukumi atbilst lib/supabase.ts; Supabase > Settings > API Keys)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # publiskā atslēga (sb_publishable_...), drīkst būt pārlūkā
# SUPABASE_SECRET_KEY=                    # SLEPENĀ atslēga (sb_secret_...) — tikai serverim, NEKAD ar NEXT_PUBLIC_

# Push notifications — generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Cron (generate any random string, add to Vercel env vars too)
# Vercel Cron to nosūta automātiski kā Authorization: Bearer. Dienas produkts to lieto arī,
# lai PARAKSTĪTU "Publicēt" saiti e-pastā — nomainot CRON_SECRET, jau nosūtītās saites nederēs.
# CRON_SECRET=

# Paysera
# Mode: live / test / mock (mock = skip Paysera, redirect straight to success — for E2E tests)
# PAYSERA_MODE=test
# PAYSERA_PROJECT_ID=                 # tirgus.izipizi.lv projekts SIA IziPizi kontā
#                                     # JĀSAKRĪT ar operatorInfo.paysera.projectId (lib/operator-info.ts)
# PAYSERA_SIGN_PASSWORD=              # Paysera projekta paroļu sadaļā — atjaunojama brīvi
# Callback URL Paysera projektā: https://tirgus.izipizi.lv/api/webhooks/paysera

# Public site URL (used in Paysera accept/cancel/callback URLs; falls back to request host)
# NEXT_PUBLIC_SITE_URL=https://tirgus.izipizi.lv

# Resend (transactional email — order confirmations, seller reminders, etc.)
# https://resend.com → API Keys (after domain verification)
# RESEND_API_KEY=re_...
# EMAIL_FROM="tirgus.izipizi.lv <noreply@tirgus.izipizi.lv>"
# EMAIL_REPLY_TO=tirgus@izipizi.lv
#
# Supabase Auth magic-links use a separate SMTP config in Supabase Dashboard
# (Authentication → SMTP). Point that at smtp.resend.com:587 with your
# Resend API key as the password — same Resend account, different surface.

# Esteria SMS (lieto izipizi.lv pasūtījumu paziņojumiem)
# Send: https://api.esteria.eu/send · Status: https://api1.esteria.lv/status-xml
# Limits: 160 chars, no Latvian diacritics (auto-transliterated)
# ESTERIA_API_KEY=
# ESTERIA_SENDER=IziPiziAPP

# izipizi Locker API (add later)
# IZIPIZI_API_URL=
# IZIPIZI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Dienas produkts — automātiska publicēšana (app/api/cron/daily-product)
# Pilns apraksts un pārbaude: apps/tirgus/docs/dienas-produkts.md
#
# JAU IR citiem mērķiem (atkārtoti nav jāliek): CRON_SECRET, SUPABASE_SECRET_KEY,
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SITE_URL, RESEND_API_KEY, EMAIL_FROM,
# GEMINI_API_KEY (to pašu lieto AI asistents).
# JAUNI šai funkcijai: DAILY_PRODUCT_*, META_*.
# ─────────────────────────────────────────────────────────────────────────────
# Režīms. NENORĀDĪT vai draft = katru rītu e-pasts ar pogu "Publicēt" (drošais noklusējums).
# live = publicē uzreiz bez apstiprinājuma. Jebkura cita vērtība = draft.
# DAILY_PRODUCT_MODE=draft
#
# Kam sūtīt melnrakstu (draft režīmā OBLIGĀTS kopā ar RESEND_API_KEY).
# Ja trūkst, melnraksts tiek izveidots, bet e-pasts NETIEK sūtīts un pogas nav —
# tad publicēt var tikai ar ?force=1. E-pasts tiek sūtīts tikai dienas pirmajā izsaukumā.
# DAILY_PRODUCT_PREVIEW_EMAIL=
#
# Teksta ģenerēšana. Ja trūkst, tiek lietots fiksēts teksts bez AI.
# GEMINI_API_KEY=
#
# Meta Graph API (Meta for Developers → app → Instagram Graph API + Pages).
# Vajag tikai tad, kad publicē (live režīms vai poga). Bez šiem ieraksts iegūst statusu
# 'failed' ar kļūdu tabulā social_daily_posts.error — nekas netiek publicēts.
# META_GRAPH_VERSION=v23.0              # neobligāts, noklusējums v23.0
# META_FB_PAGE_ID=                      # svaigi.lv Facebook lapas ID
# META_FB_PAGE_TOKEN=                   # svaigi.lv lapas ilgtermiņa (nebeidzas) Page access token
# META_IG_USER_ID=                      # tirgus.izipizi.lv Instagram Business konta ID
# META_IG_ACCESS_TOKEN=                 # tās FB lapas Page token, kurai piesaistīts IG; tukšs = lieto META_FB_PAGE_TOKEN
